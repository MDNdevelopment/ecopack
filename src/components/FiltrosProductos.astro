---
import empresa from '../data/empresa.json';
import { familias, categorias, materialCorto } from '../lib/productos';

const total = familias.length;
const cats = categorias
	.map((c) => ({ ...c, n: familias.filter((f) => f.categoria === c.value).length }))
	.filter((c) => c.n > 0)
	.sort((a, b) => b.n - a.n);
const mats = (Object.keys(materialCorto) as (keyof typeof materialCorto)[])
	.map((m) => ({ value: m, label: materialCorto[m], n: familias.filter((f) => f.material === m).length }))
	.filter((m) => m.n > 0)
	.sort((a, b) => b.n - a.n);
---

<!-- Celular / iPad vertical: buscador + botón que abre el panel -->
<div class="f-mobile" data-filtros-ui>
	<label class="f-search">
		<span aria-hidden="true">⌕</span>
		<input type="search" data-filtro-search placeholder="Buscar producto…" aria-label="Buscar producto" />
	</label>
	<button type="button" class="f-open" data-filtro-open aria-controls="filtros-panel">⚙ Filtros <span data-filtro-badge hidden></span></button>
</div>

<aside class="f-side" id="filtros-panel" data-filtros data-filtros-ui aria-label="Filtros de productos">
	<div class="f-panel">
		<div class="f-panel-head">
			<div>
				<p class="f-kicker">Catálogo</p>
				<p class="f-title">Filtrar productos</p>
			</div>
			<button type="button" class="f-close" data-filtro-close aria-label="Cerrar filtros">✕</button>
		</div>
		<label class="f-search f-search-desk">
			<span aria-hidden="true">⌕</span>
			<input type="search" data-filtro-search placeholder="Buscar producto…" aria-label="Buscar producto" />
		</label>

		<fieldset class="f-group">
			<legend><span class="f-legend-icon" aria-hidden="true">◐</span> ¿Para qué lo usas?</legend>
			{
				cats.map((c) => (
					<label class="f-check">
						<input type="checkbox" data-filtro-check="categoria" value={c.value} data-label={c.label} />
						<span class="f-box" aria-hidden="true" />
						<span class="f-name">{c.label}</span>
						<em>{c.n}</em>
					</label>
				))
			}
		</fieldset>

		<fieldset class="f-group">
			<legend><span class="f-legend-icon" aria-hidden="true">♻</span> Material</legend>
			{
				mats.map((m) => (
					<label class="f-check">
						<input type="checkbox" data-filtro-check="material" value={m.value} data-label={m.label} />
						<span class="f-box" aria-hidden="true" />
						<span class="f-name">{m.label}</span>
						<em>{m.n}</em>
					</label>
				))
			}
		</fieldset>

		<div class="f-actions">
			<button type="button" class="f-clear" data-filtro-clear>Limpiar filtros</button>
			<button type="button" class="f-apply" data-filtro-close>Ver <span data-filtro-count>{total}</span> productos</button>
		</div>
	</div>

	<div class="f-help">
		<p class="f-help-title">¿No encuentras lo que buscas?</p>
		<p>Te asesoramos por WhatsApp o descarga el catálogo completo.</p>
		<div class="f-help-btns">
			<a href={`https://wa.me/${empresa.telefonoWhatsapp}`} target="_blank" rel="noopener" class="f-help-wa">Escríbenos</a>
			<a href="/catalogo-ecopack.pdf" download class="f-help-pdf">PDF ↓</a>
		</div>
	</div>
</aside>
<div class="f-backdrop" data-filtro-close hidden></div>

<noscript>
	<style>
		[data-filtros-ui] {
			display: none !important;
		}
	</style>
</noscript>

<script src="../scripts/filtro-productos.ts"></script>

<style>
	.f-side {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.f-panel {
		background: var(--color-cream-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		box-shadow: 0 10px 30px rgba(0, 40, 50, 0.06);
		padding: 22px 18px 18px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.f-panel-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding: 0 4px;
	}
	.f-kicker {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-lime-accent-hover);
		margin: 0 0 2px;
	}
	.f-title {
		font-family: var(--font-display);
		font-size: 24px;
		line-height: 1.1;
		text-transform: uppercase;
		color: var(--color-ink);
		margin: 0;
	}
	.f-close,
	.f-apply,
	.f-mobile {
		display: none;
	}
	.f-search {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 2px 16px;
		background: var(--color-cream);
		border: 1px solid var(--color-border-soft);
		border-radius: var(--radius-pill);
		color: var(--color-text-muted);
		transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
	}
	.f-search:focus-within {
		border-color: var(--color-green-dark);
		box-shadow: 0 0 0 3px rgba(0, 80, 103, 0.12);
	}
	.f-search input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		font: inherit;
		font-size: 16px;
		color: var(--color-ink);
		padding: 10px 0;
	}
	.f-group {
		border: 0;
		margin: 0;
		padding: 16px 0 0;
		border-top: 1px solid var(--color-sage-line);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.f-group legend {
		float: left;
		width: 100%;
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-green-dark);
		margin-bottom: 8px;
		padding: 0 4px;
	}
	.f-legend-icon {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--color-sage);
		font-size: 12px;
	}
	.f-check {
		position: relative;
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
		padding: 0 10px;
		border-radius: 12px;
		font-size: 15px;
		cursor: pointer;
		transition: background var(--duration-fast) var(--ease-out);
	}
	@media (hover: hover) {
		.f-check:hover {
			background: var(--color-sage);
		}
	}
	.f-check input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.f-box {
		flex: none;
		width: 20px;
		height: 20px;
		border-radius: 6px;
		border: 1.5px solid var(--color-border-soft);
		background: #fff;
		display: grid;
		place-items: center;
		transition: background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
	}
	.f-box::after {
		content: '';
		width: 10px;
		height: 6px;
		border-left: 2px solid var(--color-cream);
		border-bottom: 2px solid var(--color-cream);
		transform: rotate(-45deg) translate(1px, -1px) scale(0);
		transition: transform var(--duration-fast) var(--ease-out);
	}
	.f-check input:checked ~ .f-box {
		background: var(--color-green-dark);
		border-color: var(--color-green-dark);
	}
	.f-check input:checked ~ .f-box::after {
		transform: rotate(-45deg) translate(1px, -1px) scale(1);
	}
	.f-check input:focus-visible ~ .f-box {
		outline: 2px solid var(--color-green-dark);
		outline-offset: 2px;
	}
	.f-check:has(input:checked) {
		background: var(--color-sage);
		font-weight: 600;
	}
	.f-name {
		flex: 1;
	}
	.f-check em {
		font-style: normal;
		font-size: 12px;
		font-weight: 700;
		min-width: 26px;
		text-align: center;
		padding: 3px 8px;
		border-radius: var(--radius-pill);
		background: var(--color-cream);
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
	}
	.f-check:has(input:checked) em {
		background: var(--color-green-dark);
		border-color: var(--color-green-dark);
		color: var(--color-cream);
	}
	.f-actions {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.f-clear {
		border: 1px solid var(--color-border-soft);
		background: transparent;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		color: var(--color-green-dark);
		padding: 11px;
		border-radius: var(--radius-pill);
		opacity: 0.45;
		pointer-events: none;
		transition: opacity var(--duration-fast) var(--ease-out);
	}
	:global(.has-filtros) .f-clear {
		opacity: 1;
		pointer-events: auto;
	}
	.f-help {
		background: var(--color-green-deep);
		color: var(--color-text-on-dark);
		border-radius: var(--radius-card);
		padding: 20px;
		font-size: 14px;
		line-height: 1.45;
	}
	.f-help p {
		margin: 0;
	}
	.f-help .f-help-title {
		font-family: var(--font-display);
		font-size: 19px;
		color: var(--color-cream);
		margin-bottom: 6px;
	}
	.f-help-btns {
		display: flex;
		gap: 8px;
		margin-top: 14px;
	}
	.f-help-btns a {
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		padding: 9px 16px;
		border-radius: var(--radius-pill);
	}
	.f-help-wa {
		flex: 1;
		text-align: center;
		background: var(--color-lime);
		color: var(--color-ink);
	}
	.f-help-pdf {
		border: 1px solid rgba(255, 255, 255, 0.3);
		color: var(--color-cream);
	}
	:global(body.filtros-open .wa-float) {
		display: none;
	}

	/* iPad horizontal y escritorio mediano: panel más compacto */
	@media (min-width: 900px) and (max-width: 1199px) {
		.f-panel {
			padding: 18px 12px 14px;
			gap: 14px;
		}
		.f-check {
			gap: 10px;
			padding: 0 8px;
			font-size: 14px;
		}
	}
	@media (min-width: 900px) and (max-height: 820px) {
		.f-check {
			min-height: 40px;
		}
		.f-group {
			padding-top: 12px;
		}
	}

	/* Celular / iPad vertical: panel deslizable */
	@media (max-width: 899px) {
		.f-mobile {
			display: flex;
			gap: 10px;
			margin-bottom: 24px;
		}
		.f-mobile .f-search {
			flex: 1;
			min-width: 0;
			background: var(--color-cream-card);
		}
		.f-open {
			flex: none;
			border: 0;
			background: var(--color-green-dark);
			color: var(--color-cream);
			font: inherit;
			font-size: 14px;
			font-weight: 600;
			padding: 0 18px;
			border-radius: var(--radius-pill);
		}
		.f-open span {
			background: var(--color-lime);
			color: var(--color-ink);
			font-size: 12px;
			padding: 1px 7px;
			border-radius: var(--radius-pill);
			margin-left: 4px;
		}
		.f-search-desk {
			display: none;
		}
		.f-side {
			position: fixed;
			top: 0;
			right: 0;
			bottom: 0;
			z-index: 60;
			width: min(340px, 88vw);
			overflow-y: auto;
			background: var(--color-cream);
			padding: 16px;
			transform: translateX(100%);
			visibility: hidden;
			transition: transform var(--duration-fast) var(--ease-out), visibility 0s linear var(--duration-fast);
		}
		.f-side.is-open {
			transform: none;
			visibility: visible;
			transition: transform var(--duration-fast) var(--ease-out);
			box-shadow: -20px 0 40px rgba(0, 30, 40, 0.2);
		}
		.f-close {
			display: grid;
			place-items: center;
			border: 0;
			background: var(--color-sage);
			width: 36px;
			height: 36px;
			border-radius: 50%;
			font-size: 14px;
		}
		.f-apply {
			display: block;
			border: 0;
			background: var(--color-green-dark);
			color: var(--color-cream);
			font: inherit;
			font-weight: 600;
			padding: 14px;
			border-radius: var(--radius-pill);
		}
		.f-backdrop {
			position: fixed;
			inset: 0;
			z-index: 55;
			background: rgba(0, 30, 40, 0.4);
		}
	}
	.f-backdrop[hidden] {
		display: none;
	}
</style>
