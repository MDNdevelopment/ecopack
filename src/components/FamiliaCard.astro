---
import { Image } from 'astro:assets';
import PlaceholderMedia from './PlaceholderMedia.astro';
import type { Familia } from '../data/types';
import { imagenProducto } from '../lib/imagenes';
import { coloresDe, materialCorto, searchBlob } from '../lib/productos';

export interface Props {
	familia: Familia;
	/** Sólo la grilla de /productos necesita los data-* que lee el filtro. */
	filtrable?: boolean;
}
const { familia, filtrable = false } = Astro.props;
const foto = imagenProducto(familia.slug);
const n = familia.items.length;
const colores = coloresDe(familia.color);
const filtroAttrs = filtrable
	? { 'data-familia': '', 'data-categoria': familia.categoria, 'data-material': familia.material, 'data-search': searchBlob(familia) }
	: {};
---

<a class="card" href={`/productos/${familia.slug}`} {...filtroAttrs}>
	<div class="card-media">
		{
			foto ? (
				<Image src={foto} alt={`${familia.nombre} de Ecopack`} width={400} height={400} densities={[1, 2]} loading="lazy" />
			) : (
				<PlaceholderMedia label={familia.nombre} tone="light" />
			)
		}
		{
			colores.length > 0 && (
				<span class="card-colores" role="img" aria-label={`Colores: ${colores.map((c) => c.label.toLowerCase()).join(', ')}`}>
					{colores.map((c) => (
						<span class="dot" style={`background:${c.css}`} title={c.label} />
					))}
				</span>
			)
		}
	</div>
	<div class="card-body">
		<h3>{familia.nombre}</h3>
		<p>{materialCorto[familia.material]}</p>
		<span class="card-count">{n} {n === 1 ? 'referencia' : 'referencias'} <span aria-hidden="true">→</span></span>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		color: var(--color-ink);
	}
	.card[hidden] {
		display: none;
	}
	.card-media {
		position: relative;
		aspect-ratio: 1 / 1;
		border-radius: var(--radius-product-img);
		background: var(--color-cream-media);
		overflow: hidden;
	}
	.card-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-slow) var(--ease-out);
	}
	.card:hover .card-media :global(img),
	.card:focus-visible .card-media :global(img) {
		transform: scale(1.05);
	}
	.card-body {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	h3 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 22px;
		line-height: 1.1;
		text-wrap: balance;
	}
	p {
		margin: 0;
		font-size: 14px;
		color: var(--color-text-muted);
	}
	.card-colores {
		position: absolute;
		left: 10px;
		bottom: 10px;
		display: flex;
		gap: 6px;
		padding: 6px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
	}
	.dot {
		width: 18px;
		height: 18px;
		flex: none;
		border-radius: 50%;
		/* Aro con sombra interior: un border dejaba que el degradado se repitiera bajo el borde y asomaba el otro color. */
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.28);
	}
	.card-count {
		margin-top: 4px;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-green-dark);
	}
	@media (prefers-reduced-motion: reduce) {
		.card-media :global(img) {
			transition: none;
		}
	}
</style>
