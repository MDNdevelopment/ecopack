---
/**
 * Stand-in for a photo/video not yet supplied by the client.
 * Renders a lightweight brand-colored block (no network weight) with an
 * accessible label so it never masquerades as decorative-only content.
 * Swap for <Image>/<video> once real assets arrive — see PENDIENTES.md.
 */
export interface Props {
	label: string;
	tone?: 'dark' | 'light';
	aspect?: string;
}
const { label, tone = 'dark', aspect } = Astro.props;
---

<div class:list={['placeholder-media', tone]} style={aspect ? `aspect-ratio:${aspect}` : undefined} role="img" aria-label={label}>
	<svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2v10h14V7H5Zm2 8 3.5-4.5 2.5 3 2-2.5L18 15H7Zm2-6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z"
		></path>
	</svg>
	<span>{label}</span>
</div>

<style>
	.placeholder-media {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		width: 100%;
		height: 100%;
		min-height: 100%;
		text-align: center;
		padding: 16px;
		box-sizing: border-box;
	}
	.placeholder-media span {
		font-size: 13px;
		font-weight: 600;
		max-width: 26ch;
		line-height: 1.4;
	}
	.placeholder-media.dark {
		background: linear-gradient(135deg, var(--color-green-deep), var(--color-green-dark));
		color: rgba(244, 242, 233, 0.55);
	}
	.placeholder-media.light {
		background: linear-gradient(135deg, var(--color-sage), var(--color-border));
		color: var(--color-text-muted);
	}
</style>
