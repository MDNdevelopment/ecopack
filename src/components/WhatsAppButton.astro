---
import empresa from '../data/empresa.json';
---

<a
	href={`https://wa.me/${empresa.telefonoWhatsapp}`}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Escríbenos por WhatsApp"
	class="wa-float"
	data-wa
>
	<span class="wa-ring" aria-hidden="true" data-wa-ring></span>
	<svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
		<path
			fill="#fff"
			d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.4.66 4.63 1.8 6.55L4 29l7.6-1.75a11.9 11.9 0 0 0 4.42.85c6.63 0 12.02-5.4 12.02-12.03C28.04 8.4 22.65 3 16.02 3Zm0 21.7c-1.5 0-2.93-.4-4.18-1.1l-.3-.17-4.5 1.04 1.08-4.4-.2-.3a9.63 9.63 0 0 1-1.5-5.15c0-5.34 4.34-9.68 9.6-9.68 5.27 0 9.6 4.34 9.6 9.68 0 5.34-4.33 9.68-9.6 9.68Zm5.27-7.25c-.29-.15-1.7-.84-1.96-.94-.26-.1-.46-.14-.65.15-.2.29-.75.94-.92 1.13-.17.2-.34.22-.63.07-.29-.14-1.2-.44-2.29-1.4-.85-.75-1.42-1.68-1.59-1.96-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.5.15-.18.2-.3.29-.5.1-.2.05-.37-.02-.51-.07-.15-.65-1.55-.89-2.13-.24-.57-.48-.49-.65-.5h-.55c-.2 0-.51.07-.78.36-.26.29-1.02 1-1.02 2.44s1.05 2.83 1.19 3.02c.15.2 2.06 3.15 5 4.41.7.3 1.24.48 1.67.62.7.22 1.34.19 1.84.11.56-.08 1.7-.7 1.94-1.37.24-.68.24-1.26.17-1.38-.07-.13-.26-.2-.55-.35Z"
		></path>
	</svg>
</a>

<script src="../scripts/wa-button.ts"></script>

<style>
	.wa-float {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 60;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: var(--color-whatsapp);
		display: grid;
		place-items: center;
		box-shadow: var(--shadow-wa);
	}
	.wa-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid var(--color-whatsapp);
		pointer-events: none;
	}
</style>
