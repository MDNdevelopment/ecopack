---
interface Props {
	red: 'instagram' | 'tiktok' | 'youtube' | 'facebook' | 'linkedin';
	size?: number;
}
const { red, size = 28 } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="1.9"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{red === 'instagram' && (
		<>
			<rect x="3" y="3" width="18" height="18" rx="5.2" />
			<circle cx="12" cy="12" r="4.1" />
			<circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" />
		</>
	)}
	{red === 'tiktok' && (
		<>
			<path d="M14 3v11.5a3.6 3.6 0 1 1-3.6-3.6" />
			<path d="M14 3c.3 2.6 2 4.3 5 4.6" />
		</>
	)}
	{red === 'youtube' && (
		<>
			<rect x="2.5" y="5.5" width="19" height="13" rx="4" />
			<path d="M10.2 9.4v5.2l4.5-2.6z" fill="currentColor" />
		</>
	)}
	{red === 'facebook' && <path d="M14.2 21v-8h2.7l.5-3.3h-3.2V7.9c0-.9.4-1.7 1.8-1.7h1.5V3.3S16.2 3 15 3c-2.6 0-4.3 1.6-4.3 4.4v2.3H8v3.3h2.7v8z" fill="currentColor" stroke="none" />}
	{red === 'linkedin' && (
		<g fill="currentColor" stroke="none">
			<rect x="3.2" y="9" width="3.8" height="12" rx="0.6" />
			<circle cx="5.1" cy="5.1" r="2.2" />
			<path d="M10 9h3.6v1.7c.6-1.1 1.9-2 3.7-2 3.1 0 3.7 2 3.7 4.7V21h-3.8v-6.3c0-1.4-.1-2.5-1.7-2.5s-1.9 1.1-1.9 2.4V21H10z" />
		</g>
	)}
</svg>
